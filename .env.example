# Django
SECRET_KEY=replace_with_a_secure_key
DEBUG=True

# Mercado Pago (Yape)
# Clave pública para inicializar el SDK en el frontend
MP_PUBLIC_KEY=YOUR_MP_PUBLIC_KEY
# Token privado para crear pagos desde el backend
MP_ACCESS_TOKEN=YOUR_MP_ACCESS_TOKEN

# Stripe (si usas la parte de tarjetas del README)
STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXX

# Otros
# Agrega aquí variables adicionales según tu entorno
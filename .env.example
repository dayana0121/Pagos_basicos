SECRET_KEY=replace_with_a_secure_key
DEBUG=True
# Mercado Pago (Yape)
MP_PUBLIC_KEY=TEST-885a6c31-fc91-4580-b6c6-4ce6f41bd450
MP_ACCESS_TOKEN=TEST-3797994231532311-101413-70a213b9808fd5b3f152acbc70ac3fd2-2925872330
# Webhook (si aplica)
# URL pública donde Mercado Pago enviará las notificaciones
# Ejemplo local con ngrok: https://<tu-ngrok>.ngrok-free.app/webhook/
WEBHOOK_URL=http://localhost:8000/webhook/

# Monto por defecto para pruebas Yape (evita error de monto inválido)
YAPE_TRANSACTION_AMOUNT=5.00

# Email de pagador solo en servidor (no se pide en la UI)
# Sandbox usa automáticamente test_user si no defines este valor.
# En producción, define un correo válido de comprador.
PAYER_EMAIL=test_user_1632885034@testuser.com

# CSRF Trusted Origins (separados por coma)
# Incluye tu dominio público (ngrok/producción) y localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Modo demo para simular creación de pagos Yape sin llamar a MP
YAPE_DEMO=True